<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="24dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AirMouse"
        android:textSize="32sp"
        android:textColor="@color/accent_green"
        android:textStyle="bold"
        android:fontFamily="monospace"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gyroscope Cursor Control"
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="2dp"/>

    <!-- Connection Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardConnection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVER"
                android:textSize="10sp"
                android:textColor="@color/text_muted"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.15"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <EditText
                    android:id="@+id/etIpAddress"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="3"
                    android:hint="192.168.1.100"
                    android:inputType="textUri"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:fontFamily="monospace"
                    android:background="@drawable/input_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:imeOptions="actionNext"
                    android:singleLine="true"/>

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp"/>

                <EditText
                    android:id="@+id/etPort"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="8765"
                    android:inputType="number"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:fontFamily="monospace"
                    android:background="@drawable/input_bg"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:imeOptions="actionDone"
                    android:singleLine="true"/>

            </LinearLayout>

            <!-- Protocol selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <RadioGroup
                    android:id="@+id/rgProtocol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbWs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ws://"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:checked="true"
                        android:buttonTint="@color/accent_green"/>

                    <RadioButton
                        android:id="@+id/rbWss"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="wss:// (TLS)"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:layout_marginStart="20dp"
                        android:buttonTint="@color/accent_green"/>

                </RadioGroup>

            </LinearLayout>

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="CONNECT"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:backgroundTint="@color/accent_green"
                android:textColor="@color/bg_dark"
                app:cornerRadius="10dp"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Status Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardConnection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_dot_disconnected"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Disconnected"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:layout_marginStart="10dp"/>

                <TextView
                    android:id="@+id/tvLatency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--ms"
                    android:textSize="12sp"
                    android:textColor="@color/accent_green"
                    android:fontFamily="monospace"/>

            </LinearLayout>

            <!-- Gyro values display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="α alpha"
                        android:textSize="10sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="monospace"/>
                    <TextView
                        android:id="@+id/tvAlpha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0°"
                        android:textSize="18sp"
                        android:textColor="@color/accent_blue"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="β beta"
                        android:textSize="10sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="monospace"/>
                    <TextView
                        android:id="@+id/tvBeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0°"
                        android:textSize="18sp"
                        android:textColor="@color/accent_orange"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="γ gamma"
                        android:textSize="10sp"
                        android:textColor="@color/text_muted"
                        android:fontFamily="monospace"/>
                    <TextView
                        android:id="@+id/tvGamma"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0°"
                        android:textSize="18sp"
                        android:textColor="@color/accent_green"
                        android:textStyle="bold"
                        android:fontFamily="monospace"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Sensitivity + Controls Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/cardStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SENSITIVITY"
                    android:textSize="10sp"
                    android:textColor="@color/text_muted"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"/>

                <TextView
                    android:id="@+id/tvSensitivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.0x"
                    android:textSize="13sp"
                    android:textColor="@color/accent_green"
                    android:fontFamily="monospace"/>

            </LinearLayout>

            <SeekBar
                android:id="@+id/seekSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="40"
                android:progress="10"
                android:progressTint="@color/accent_green"
                android:thumbTint="@color/accent_green"/>

            <!-- Send rate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SEND RATE"
                    android:textSize="10sp"
                    android:textColor="@color/text_muted"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"/>

                <TextView
                    android:id="@+id/tvSendRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 Hz"
                    android:textSize="13sp"
                    android:textColor="@color/accent_blue"
                    android:fontFamily="monospace"/>

            </LinearLayout>

            <SeekBar
                android:id="@+id/seekSendRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="9"
                android:progress="5"
                android:progressTint="@color/accent_blue"
                android:thumbTint="@color/accent_blue"/>

            <!-- Click buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/btnLeftClick"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="LEFT\nCLICK"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/bg_dark"
                    android:backgroundTint="@color/accent_green"
                    app:cornerRadius="10dp"/>

                <View android:layout_width="10dp" android:layout_height="1dp"/>

                <Button
                    android:id="@+id/btnRightClick"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="RIGHT\nCLICK"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/card_bg_2"
                    app:cornerRadius="10dp"

                <View android:layout_width="10dp" android:layout_height="1dp"/>

                <Button
                    android:id="@+id/btnCalibrate"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="ZERO\nCALIB"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/accent_orange"
                    android:backgroundTint="@color/card_bg_2"
                    app:cornerRadius="10dp"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Packets sent counter at bottom -->
    <TextView
        android:id="@+id/tvPacketCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="packets sent: 0"
        android:textSize="11sp"
        android:textColor="@color/text_muted"
        android:fontFamily="monospace"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
